# SignalScope Production & Deployment Environment Configuration

# Server & Runtime Configuration
APP_ENV=production
PORT=8000
LOG_LEVEL=INFO
DEVICE=cpu

# Model Checkpoint & Calibration Resolution
# If local files are not mounted, the service can fetch from MODEL_URL / SCALER_URL
MODEL_PATH=checkpoints/baseline_convnext/best_model.pt
MODEL_URL=
SCALER_PATH=checkpoints/baseline_convnext/temperature_scaler.json
SCALER_URL=
MODEL_CACHE_DIR=cache/models

# Production CORS Security (comma-separated list of allowed frontend origins)
FRONTEND_ORIGIN=http://localhost:3000,https://signalscope.vercel.app

# Data Root (local evaluation strictly; organizer test set untouched)
SIGNALSCOPE_DATA_ROOT=C:\Programming\SignalScope-data
